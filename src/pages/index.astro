---
import Section from "@/components/sections/Section.astro"
import Layout from "../layouts/Layout.astro"
import Heading from "@/components/headings/Heading.astro"
import Button from "@/components/starwind/button/Button.astro"
---

<Layout title="Welcome to MYNK">
  <Section class="grid place-content-center">
    <div class="flex flex-col gap-4 items-center">
      <Heading as="h1" size="5xl" class="text-white text-center text-shadow-md">
        Welcome to <br />
        MYNK for Bloons
      </Heading>
      <Button as="a" size="3xl" variant="hero_button" href="/users">
        Check out the users
      </Button>
    </div>
  </Section>
</Layout>
