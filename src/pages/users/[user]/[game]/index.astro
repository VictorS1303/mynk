---
import { users } from "@/lib/utils/dummy_data/users/users"
import { games } from "@/lib/utils/dummy_data/games/games"
import { levels } from "@/lib/utils/dummy_data/levels/levels"
import PackLevelsPageLayout from "@/layouts/PackLevelsPageLayout.astro"
import Section from "@/components/sections/Section.astro"
import Heading from "@/components/headings/Heading.astro"
import PackLevelsContainer from "@/components/containers/PackLevelsContainer.astro"

export function getStaticPaths() {
  return users.flatMap((user) =>
    games
      .filter((game) => game.user_id === user.id)
      .map((game) => ({
        params: {
          user: user.username,
          game: game.pack_slug,
        },
        props: {
          user,
          game,
          levels: levels.filter((level) => level.game_id === String(game.id)),
        },
      })),
  )
}

const { user, game, levels: gameLevels } = Astro.props
---

<PackLevelsPageLayout title={`${game.pack_name} by ${user.username}`}>
  <Section class="grid place-content-start place-items-start">
    <Heading size="3xl" class="text-white">
      {game.pack_name} <span class="text-2xl"> - by {user.username}</span>
    </Heading>

    <PackLevelsContainer
      username={user.username}
      game={game}
      levels={gameLevels}
    />
  </Section>
</PackLevelsPageLayout>
